---
import Arrow from './Arrow.astro';
---
<dialog id="quote-dialog" aria-labelledby="quote-heading" aria-describedby="quote-intro">
  <div class="quote-panel">
    <div class="quote-top"><p class="eyebrow">ZAPYTANIE / WYCENA</p><button class="quote-close" type="button" aria-label="Zamknij formularz">×</button></div>
    <h2 id="quote-heading">Wyceń kampanię.</h2>
    <p id="quote-intro">Kilka informacji na dobry początek. Na ich podstawie przygotujemy propozycję dopasowaną do Twoich potrzeb.</p>
    <form id="quote-form">
      <div class="quote-trap" aria-hidden="true"><label>Strona internetowa<input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <fieldset><legend>Co Cię interesuje? <span>(wybierz co najmniej jedną usługę)</span></legend><div class="quote-services">
        {['Kolportaż materiałów', 'Reklama w taxi', 'Meta Ads', 'Google Ads', 'Akcje promocyjne', 'Strony WWW i obsługa', 'Potrzebuję doradztwa'].map(service => <label><input type="checkbox" name="service" value={service} /><span>{service}</span></label>)}
      </div><p class="field-error" id="service-error" role="alert" hidden>Wybierz co najmniej jedną usługę.</p></fieldset>
      <div class="quote-fields">
        <label>Imię / firma <input name="name" autocomplete="organization" required maxlength="120" placeholder="Jak się do Ciebie zwracać?" /></label>
        <label>E-mail (wymagany) <input type="email" name="email" autocomplete="email" required maxlength="180" placeholder="twoj@adres.pl" /></label>
        <label>Obszar działań <input name="area" required maxlength="160" placeholder="Np. Szczecin, województwo lub cała Polska" /></label>
        <label>Planowany start <input name="timing" maxlength="120" placeholder="Np. wrzesień / do ustalenia (opcjonalnie)" /></label>
        <label class="quote-wide">Orientacyjny budżet <select name="budget"><option>Do ustalenia</option><option>Do 2 000 zł</option><option>2 000–5 000 zł</option><option>5 000–10 000 zł</option><option>Powyżej 10 000 zł</option></select><span class="field-hint">Łączny planowany budżet kampanii. Jeśli jeszcze go nie znasz, wybierz „Do ustalenia”.</span></label>
        <label class="quote-wide">Co chcesz promować i osiągnąć? <textarea name="brief" rows="3" required maxlength="2000" placeholder="Opisz produkt, odbiorców i cel. Przy kolportażu podaj nakład, jeśli go znasz."></textarea></label>
      </div>
      <p class="quote-note">Dane z formularza wykorzystamy do obsługi Twojego zapytania. Wiadomość trafi do Benny Invest Sp. z o.o. na biuro@bennyinvest.pl. Nie zapisujemy jej w przeglądarce.</p>
      <p id="quote-status" class="quote-status" role="status" aria-live="polite"></p>
      <button class="quote-submit" type="submit">Wyślij zapytanie <Arrow /></button>
    </form>
    <section id="quote-result" aria-labelledby="quote-result-heading" hidden>
      <h3 id="quote-result-heading">Dziękujemy za zapytanie.</h3>
      <p id="quote-result-message"></p>
      <div id="quote-fallback">
      <a id="quote-mail" class="quote-submit" href="mailto:biuro@bennyinvest.pl">Otwórz program pocztowy <Arrow /></a>
      <label class="quote-copy-label">Treść do skopiowania<textarea id="quote-copy" rows="7" readonly></textarea></label>
      </div>
      <button id="quote-edit" class="text-link" type="button">Wróć do formularza</button>
    </section>
  </div>
</dialog>
<script>
  import { sitePath } from '../utils/site';
  const dialog = document.querySelector<HTMLDialogElement>('#quote-dialog')!;
  const form = document.querySelector<HTMLFormElement>('#quote-form')!;
  const result = document.querySelector<HTMLElement>('#quote-result')!;
  const serviceError = document.querySelector<HTMLElement>('#service-error')!;
  let opener: HTMLElement | null = null;
  document.querySelectorAll<HTMLButtonElement>('[data-open-quote]').forEach(button => {
    button.addEventListener('click', () => {
      opener = button;
      form.hidden = false;
      result.hidden = true;
      serviceError.hidden = true;
      if (button.dataset.quoteServices) {
        const selected = button.dataset.quoteServices.split('|');
        form.querySelectorAll<HTMLInputElement>('[name="service"]').forEach(input => { input.checked = selected.includes(input.value); });
      }
      dialog.showModal();
      document.body.classList.add('quote-open');
    });
  });
  dialog.querySelector('.quote-close')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    document.body.classList.remove('quote-open');
    opener?.focus();
  });
  form.addEventListener('change', () => { serviceError.hidden = true; });
  form.addEventListener('submit', async event => {
    event.preventDefault();
    const data = new FormData(form);
    const services = data.getAll('service').map(String);
    if (!services.length) {
      serviceError.hidden = false;
      form.querySelector<HTMLInputElement>('[name="service"]')!.focus();
      return;
    }
    const value = (key: string) => String(data.get(key) ?? '').trim();
    const body = [
      'Proszę o wycenę kampanii.', '',
      `Imię / firma: ${value('name')}`, `E-mail: ${value('email')}`,
      `Usługi: ${services.join(', ')}`, `Obszar działań: ${value('area')}`,
      `Planowany start: ${value('timing') || 'Do ustalenia'}`, `Budżet: ${value('budget')}`,
      '', 'Opis i cel kampanii:', value('brief'),
    ].join('\n');
    document.querySelector<HTMLAnchorElement>('#quote-mail')!.href = `mailto:biuro@bennyinvest.pl?subject=${encodeURIComponent('Zapytanie o wycenę kampanii')}&body=${encodeURIComponent(body)}`;
    document.querySelector<HTMLTextAreaElement>('#quote-copy')!.value = body;
    const submit = form.querySelector<HTMLButtonElement>('[type="submit"]')!;
    if (submit.disabled) return;
    submit.disabled = true;
    const status = document.querySelector<HTMLElement>('#quote-status')!;
    status.textContent = 'Wysyłanie zapytania…';
    const message = document.querySelector<HTMLElement>('#quote-result-message')!;
    const heading = document.querySelector<HTMLElement>('#quote-result-heading')!;
    const fallback = document.querySelector<HTMLElement>('#quote-fallback')!;
    try {
      const response = await fetch(sitePath('api/quote.php'), {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        signal: AbortSignal.timeout(20000),
        body: JSON.stringify({ services, name: value('name'), email: value('email'), area: value('area'), timing: value('timing'), budget: value('budget'), brief: value('brief'), website: value('website') }),
      });
      const payload = await response.json();
      if (!response.ok || payload.ok !== true) throw new Error(typeof payload.message === 'string' ? payload.message : 'Nie udało się wysłać zapytania.');
      heading.textContent = 'Dziękujemy za zapytanie.';
      message.textContent = 'Twoje zapytanie zostało przekazane do wysyłki. Odpowiemy na podany adres e-mail.';
      fallback.hidden = true;
      form.reset();
    } catch (error) {
      heading.textContent = 'Nie udało się potwierdzić wysyłki.';
      message.textContent = (error instanceof Error && !['TimeoutError', 'TypeError', 'SyntaxError'].includes(error.name) ? error.message + ' ' : '') + 'Możesz wysłać zapytanie ze swojego programu pocztowego, skopiować treść lub zadzwonić: +48 576 243 368. Po utracie połączenia sprawdź, czy wiadomość nie została już obsłużona, zanim wyślesz ponownie.';
      fallback.hidden = false;
    } finally {
      submit.disabled = false;
      status.textContent = '';
    }
    form.hidden = true;
    result.hidden = false;
    heading.tabIndex = -1;
    heading.focus();
  });
  document.querySelector('#quote-edit')!.addEventListener('click', () => {
    result.hidden = true;
    form.hidden = false;
    form.querySelector<HTMLInputElement>('[name="name"]')!.focus();
  });
</script>
