---
import { sitePath } from '../utils/site';
---
<section id="cookie-notice" class="cookie-notice" aria-labelledby="cookie-heading" hidden>
  <p class="eyebrow">TWOJA PRYWATNOŚĆ</p><h2 id="cookie-heading">Mała informacja.<br />Twój wybór.</h2>
  <p>Zapamiętujemy Twój wybór w pamięci przeglądarki. Nie używamy analitycznych ani reklamowych cookies. Za Twoją zgodą wczytamy mapę OpenStreetMap. Jej dostawca otrzyma wtedy Twój adres IP i dane przeglądarki.</p>
  <a class="cookie-policy-link" href={sitePath('polityka-prywatnosci/')}>Polityka prywatności</a>
  <div class="cookie-actions"><button type="button" data-map-consent="allow">Akceptuję mapę</button><button type="button" data-map-consent="deny">Tylko niezbędne</button></div>
</section>
<script>
  import { readPrivacyChoice, savePrivacyChoice, type PrivacyChoice } from '../utils/privacy';
  const notice = document.querySelector<HTMLElement>('#cookie-notice')!;
  const map = document.querySelector<HTMLIFrameElement>('#location-map');
  const placeholder = document.querySelector<HTMLElement>('#map-placeholder');
  let choice = readPrivacyChoice();
  const updateMap = (allow: boolean) => {
    if (!map || !placeholder) return;
    map.hidden = !allow;
    placeholder.hidden = allow;
    if (allow) {
      // Jawny wybór działa też, gdy przeglądarka blokuje localStorage.
      map.addEventListener('load', () => map.contentWindow?.postMessage({ type: 'benny-map-consent', allow: true }, location.origin), { once: true });
      map.src = map.dataset.src!;
    } else map.removeAttribute('src');
  };
  updateMap(choice === 'allow');
  notice.hidden = choice === 'allow' || choice === 'deny';
  document.querySelectorAll<HTMLButtonElement>('[data-map-consent]').forEach(button => {
    button.addEventListener('click', () => {
      choice = button.dataset.mapConsent as PrivacyChoice;
      savePrivacyChoice(choice);
      updateMap(choice === 'allow');
      notice.hidden = true;
      if (notice.contains(document.activeElement)) document.querySelector<HTMLButtonElement>('#privacy-settings')!.focus({ preventScroll: true });
    });
  });
  document.querySelectorAll('#privacy-settings, #privacy-open-settings').forEach(button => button.addEventListener('click', () => {
    notice.hidden = false;
    notice.querySelector<HTMLButtonElement>('button')!.focus({ preventScroll: true });
  }));
</script>
