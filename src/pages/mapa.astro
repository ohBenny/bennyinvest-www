---
import 'leaflet/dist/leaflet.css';
import { sitePath } from '../utils/site';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>Obszar działania — Benny Invest</title>
    <style is:global>
      html, body, #region-map { width: 100%; height: 100%; margin: 0; }
      body { background: #e7e7e3; font-family: Arial, sans-serif; }
      .leaflet-container { background: #e7e7e3; }
      .leaflet-tile-pane { filter: grayscale(1); }
      .leaflet-control-attribution { font-size: 10px; }
      .region-notice { position: absolute; left: 50%; bottom: 30px; transform: translateX(-50%); width: max-content; max-width: 75%; padding: 8px 12px; background: #f5f5f2; border: 1px solid #aaa; color: #555; font-size: 11px; z-index: 800; }
      [hidden] { display: none !important; }
    </style>
  </head>
  <body>
    <div id="region-map" role="region" aria-label="Interaktywna mapa województwa zachodniopomorskiego. Granice zaznaczono na czerwono."></div>
    <p id="map-tile-notice" class="region-notice" role="status" hidden>Podkład mapy jest niedostępny. Czerwony obrys pokazuje granice województwa.</p>
    <noscript>Do interaktywnego podglądu potrzebny jest JavaScript. <a href="https://www.openstreetmap.org/#map=7/53.5/15.4" target="_blank" rel="noopener noreferrer">Otwórz mapę OpenStreetMap.</a></noscript>
    <a id="boundary-license" href={sitePath('licencje/polska-geojson-MIT.txt')} hidden>Licencja danych granic</a>
    <script>
      import L from 'leaflet';
      import { readPrivacyChoice } from '../utils/privacy';
      import type { GeoJsonObject } from 'geojson';
      import region from '../data/zachodniopomorskie.json';
      const map = L.map('region-map', { scrollWheelZoom: false, zoomSnap: 0.25 });
      const boundary = L.geoJSON(region as GeoJsonObject, {
        style: { color: '#c82828', weight: 3, opacity: 1, fillColor: '#c82828', fillOpacity: 0.04 },
        interactive: false,
        attribution: 'Granice: <a href="https://github.com/ppatrzyk/polska-geojson" target="_blank" rel="noopener noreferrer">polska-geojson / PRG</a>',
      }).addTo(map);
      map.fitBounds(boundary.getBounds(), { padding: [20, 20] });
      const tiles = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 18,
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a>',
      });
      const notice = document.querySelector<HTMLElement>('#map-tile-notice')!;
      tiles.on('tileerror', () => {
        if (map.hasLayer(tiles)) map.removeLayer(tiles);
        notice.hidden = false;
      });
      let started = false;
      const startTiles = () => {
        if (started) return;
        started = true;
        notice.textContent = 'Podkład mapy jest niedostępny. Czerwony obrys pokazuje granice województwa.';
        notice.hidden = true;
        tiles.addTo(map);
      };
      if (readPrivacyChoice() === 'allow') startTiles();
      else {
        notice.textContent = 'Podkład mapy wymaga zgody. Włącz go w ustawieniach prywatności na stronie głównej.';
        notice.hidden = false;
      }
      window.addEventListener('message', event => {
        if (event.origin === location.origin && event.source === window.parent && event.source !== window &&
            event.data?.type === 'benny-map-consent' && event.data.allow === true) startTiles();
      });
      new ResizeObserver(() => { map.invalidateSize(); map.fitBounds(boundary.getBounds(), { padding: [20, 20] }); }).observe(document.querySelector('#region-map')!);
    </script>
  </body>
</html>
