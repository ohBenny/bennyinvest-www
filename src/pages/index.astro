---
import '../styles/global.css';
const services = [
  { n: '01', title: 'Perspektywa', text: 'Każdy dobry projekt zaczyna się od dostrzeżenia możliwości. Patrzymy szerzej, by podejmować przemyślane decyzje.' },
  { n: '02', title: 'Partnerstwo', text: 'Stawiamy na otwartą komunikację i wspólny kierunek. Porozmawiajmy o tym, co możemy zbudować razem.' },
  { n: '03', title: 'Rozwój', text: 'Interesują nas pomysły z przyszłością. Łączymy inicjatywę z odpowiedzialnym podejściem do kolejnych kroków.' }
];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Benny Invest Sp. z o.o. — Szczecin. Poznaj nas i porozmawiajmy o możliwościach współpracy. Kontakt: biuro@bennyinvest.pl." />
    <meta name="theme-color" content="#17221f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Benny Invest — Przestrzeń dla możliwości</title>
  </head>
  <body>
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="shell flex items-center justify-between gap-6 py-7">
      <a href="#" class="brand" aria-label="Benny Invest — strona główna"><span class="brand-mark">b.</span><span>BENNY<span class="font-normal"> INVEST</span></span></a>
      <nav aria-label="Nawigacja główna" class="flex items-center gap-8 text-sm"><a class="desktop-link" href="#o-nas">O nas</a><a class="desktop-link" href="#podejscie">Nasze podejście</a><a class="nav-contact" href="#kontakt">Porozmawiajmy <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main">
      <section class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow"><span class="dot"></span> BENNY INVEST · SZCZECIN</p>
          <h1>Przestrzeń dla<br />nowych <em>możliwości.</em></h1>
          <p class="intro">Wielkie rzeczy zaczynają się od dobrej rozmowy.<br class="desktop-link" /> Poznajmy się i nadajmy pomysłom wspólny kierunek.</p>
          <a href="#kontakt" class="button">Zacznijmy rozmowę <span aria-hidden="true">↗</span></a>
          <div class="hero-note"><span class="line"></span> Myślimy perspektywicznie. Działamy razem.</div>
        </div>
        <div class="architecture" role="img" aria-label="Abstrakcyjna kompozycja architektoniczna w zieleni i ciepłej bieli">
          <div class="art-grid"></div><div class="sun"></div><div class="tower tower-back"></div><div class="tower tower-front"></div><div class="art-base"></div>
          <span class="art-label">NOWA PERSPEKTYWA</span><span class="art-coordinate">53°25′ N &nbsp; 14°33′ E</span>
          <div class="art-caption"><span>Pomysł. Kierunek. Przyszłość.</span><span aria-hidden="true">↗</span></div>
        </div>
      </section>
      <div class="values-strip"><div class="shell flex flex-wrap items-center justify-between gap-5"><span>Wspólny kierunek.</span><span>Przemyślane decyzje.</span><span>Długofalowa perspektywa.</span><span class="strip-star" aria-hidden="true">✳</span></div></div>
      <section id="o-nas" class="shell about section-space">
        <p class="eyebrow">01 / POZNAJMY SIĘ</p>
        <div><h2>Dobry początek.<br /><span class="muted">Wspólna przyszłość.</span></h2><p class="body-copy">Benny Invest to spółka ze Szczecina. Jesteśmy otwarci na rozmowy o nowych projektach i możliwościach współpracy.</p><p class="body-copy">Masz pomysł, szukasz partnera lub chcesz nas poznać? Napisz do nas — od rozmowy zaczyna się kolejny krok.</p><a class="text-link" href="mailto:biuro@bennyinvest.pl">Pozostańmy w kontakcie <span aria-hidden="true">↗</span></a></div>
      </section>
      <section id="podejscie" class="approach section-space"><div class="shell"><div class="section-heading"><div><p class="eyebrow">02 / NASZE PODEJŚCIE</p><h2>Patrzymy dalej.</h2></div><p>Możliwości nabierają znaczenia,<br />gdy stoją za nimi wspólne wartości.</p></div><div class="cards">{services.map(service => <article class="card"><div class="card-top"><span>{service.n}</span><span aria-hidden="true">↗</span></div><h3>{service.title}</h3><p>{service.text}</p></article>)}</div></div></section>
      <section id="kontakt" class="shell section-space contact"><div><p class="eyebrow"><span class="dot"></span> 03 / KONTAKT</p><h2>Porozmawiajmy<br />o <em>możliwościach.</em></h2><p class="body-copy">Dobry pomysł zasługuje na rozmowę.<br />Czekamy na Twoją wiadomość.</p><a class="email" href="mailto:biuro@bennyinvest.pl">biuro@bennyinvest.pl <span aria-hidden="true">↗</span></a></div><div class="company"><span class="brand-mark">b.</span><h3>Benny Invest Sp. z o.o.</h3><dl><div><dt>Lokalizacja</dt><dd>Szczecin, Polska</dd></div><div><dt>NIP</dt><dd>8513317048</dd></div><div><dt>E-mail</dt><dd><a href="mailto:biuro@bennyinvest.pl">biuro@bennyinvest.pl</a></dd></div></dl></div></section>
    </main>
    <footer class="shell flex flex-wrap justify-between gap-5 py-7 text-sm"><p>© {new Date().getFullYear()} Benny Invest Sp. z o.o.</p><a href="#">Wróć na górę ↑</a></footer>
  </body>
</html>
