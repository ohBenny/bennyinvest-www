---
import '../styles/global.css';
import { sitePath } from '../utils/site';
import ReplaceableImage from '../components/ReplaceableImage.astro';
import Arrow from '../components/Arrow.astro';
import QuoteForm from '../components/QuoteForm.astro';
import Partners from '../components/Partners.astro';
import CookieNotice from '../components/CookieNotice.astro';
import { team } from '../data/team';
import { services, serviceCategories } from '../data/services';
import ServiceGallery from '../components/ServiceGallery.astro';
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Benny Invest — reklama bezpośrednia, mobilna i cyfrowa. Kolportaż, kampanie terenowe, taxi, Meta i Google Ads oraz strony WWW. Szczecin, Koszalin, Stargard i zachodniopomorskie." />
    {import.meta.env.SITE_NOINDEX === '1' && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f5f5f2" />
    <link rel="icon" type="image/svg+xml" href={sitePath('favicon.svg')} />
    <title>Benny Invest — Twoja marka. Nie do przeoczenia.</title>
  </head>
  <body id="top">
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="shell flex items-center justify-between gap-6">
      <a href="#top" class="brand" aria-label="Benny Invest — strona główna">benny invest<span class="brand-period">.</span></a>
      <nav aria-label="Nawigacja główna" class="flex items-center gap-8 text-sm">
        <a class="desktop-link" href="#uslugi">Usługi</a><a class="desktop-link" href="#o-nas">O nas</a><a class="desktop-link" href="#kontakt">Kontakt</a><button class="quote-trigger" type="button" data-open-quote aria-haspopup="dialog" aria-controls="quote-dialog">Wyceń kampanię <Arrow /></button>
      </nav>
    </header>
    <main id="main">
      <section class="hero shell" aria-labelledby="hero-heading">
        <div class="hero-meta"><p>REKLAMA / KOMUNIKACJA / PROMOCJA</p><p>SZCZECIN, PL</p></div>
        <div class="hero-grid">
          <div class="hero-copy"><h1 id="hero-heading">Twoja marka.<br /><span>Nie do<br />przeoczenia.</span></h1></div>
          <div class="hero-aside">
            <figure class="poster" aria-label="Autorska abstrakcyjna kompozycja czarnych i szarych linii, inspirowana sztuką geometryczną">
              <svg viewBox="0 0 480 460" role="img" aria-label="Rytm linii tworzących przestrzenną geometryczną kompozycję">
                <defs><pattern id="lines" width="11" height="11" patternUnits="userSpaceOnUse"><path d="M0 0v11" stroke="#191919" stroke-width="4" /></pattern></defs>
                <rect x="60" y="45" width="285" height="285" fill="url(#lines)" />
                <rect x="139" y="124" width="285" height="285" fill="#f5f5f2" />
                <rect x="139" y="124" width="285" height="285" fill="url(#lines)" transform="rotate(90 281.5 266.5)" />
                <rect x="139" y="124" width="206" height="206" fill="#a3a3a3" style="mix-blend-mode:multiply" />
                <path d="M60 365h45m-22.5-22.5v45" stroke="#191919" stroke-width="1" />
              </svg>
              <figcaption><span>FORMA / RYTM</span><span>BENNY INVEST</span></figcaption>
            </figure>
            <div class="hero-intro"><p>W mieście. W sieci. W bezpośrednim kontakcie.<br />Łączymy kanały reklamy z potrzebami Twojej marki.</p><a href="#uslugi" class="text-link">Poznaj nasze usługi <Arrow /></a></div>
          </div>
        </div>
      </section>
      <section id="uslugi" class="services shell section-space" aria-labelledby="services-heading">
        <div class="section-heading"><p class="eyebrow">CO ROBIMY</p><div><h2 id="services-heading">Od pomysłu.<br /><span class="muted">Do odbiorcy.</span></h2><p class="section-intro">Specjalizujemy się w reklamie bezpośredniej.<br class="desktop-link" /> Łączymy działania w terenie, reklamę mobilną i kanały cyfrowe.</p></div></div>
        <div class="service-categories">{serviceCategories.map(category => <section class:list={['service-category', { 'service-category-featured': category.featured }]} aria-labelledby={`category-${category.id}`}><div class="service-category-heading"><div>{category.featured && <p class="specialty-label">NAJBLIŻEJ TWOICH KLIENTÓW</p>}<h3 id={`category-${category.id}`}>{category.title}</h3></div><p>{category.intro}</p></div><div class="service-list">{services.filter(service => category.serviceIds.includes(service.id)).map(service => <ServiceGallery service={service} />)}</div></section>)}</div>
      </section>
      <section class="combined shell section-space" aria-labelledby="combined-heading">
        <div class="section-heading"><p class="eyebrow">SPÓJNY PLAN</p><div><h2 id="combined-heading">Kampanie łączone.</h2><p class="section-intro">Różne kanały. Wspólny cel. Łączymy działania, żeby komunikat Twojej marki towarzyszył odbiorcom w różnych miejscach.</p></div></div>
        <div class="combined-example"><p class="eyebrow">PRZYKŁADOWY SCENARIUSZ</p><h3>Otwierasz restaurację.<br /><span class="muted">Daj się poznać w okolicy.</span></h3><p class="combined-intro">Przykładowy plan promocji nowego lokalu. Dobór kanałów i zakres działań zależą od miejsca, terminu i potrzeb restauracji.</p><div class="combined-channels"><article><h4>Kolportaż w okolicy</h4><p>Materiały z ofertą, adresem i datą otwarcia pomagają przedstawić lokal mieszkańcom wybranego obszaru.</p></article><article><h4>Kampania Meta Ads</h4><p>Reklamy na Facebooku i Instagramie prezentują menu, klimat lokalu oraz zaproszenie na otwarcie odbiorcom z uzgodnionej lokalizacji.</p></article><article><h4>Promocja terenowa</h4><p>Akcja w pobliżu restauracji daje okazję do bezpośredniej rozmowy i zaproszenia przechodniów do odwiedzin.</p></article></div><div class="combined-bottom"><p>Jeden termin otwarcia. Spójny komunikat.<br />Zakres, harmonogram i dostępność ustalamy wspólnie.</p><button class="quote-trigger" type="button" data-open-quote data-quote-services="Kolportaż materiałów|Meta Ads|Akcje promocyjne" aria-haspopup="dialog" aria-controls="quote-dialog">Zaplanuj kampanię łączoną <Arrow /></button></div></div>
      </section>
      <section id="o-nas" class="about" aria-labelledby="about-heading"><div class="shell about-grid section-space"><p class="eyebrow">BENNY INVEST</p><div><h2 id="about-heading">Mniej szumu.<br />Więcej przekazu.</h2><div class="about-copy"><p>Jesteśmy ze Szczecina. Pomagamy markom docierać do odbiorców — na ulicy, w internecie i podczas akcji promocyjnych.</p><p>Zaczynamy od rozmowy o celu. Następnie dobieramy kanały, zakres i sposób działania. Jasno, konkretnie, z uwagą na Twoją markę.</p></div><a class="text-link" href="#kontakt">Porozmawiajmy o współpracy <Arrow /></a>
        <div class="team-grid" aria-label="Zespół Benny Invest">{team.map(person => <figure class="team-card"><div class="team-photo">{person.photo ? <ReplaceableImage src={person.photo} alt={person.alt} kind="portrait" width={440} height={550} /> : <div class="team-placeholder"><span aria-hidden="true">＋</span><span>Miejsce na zdjęcie</span></div>}</div><figcaption>{person.name && <h3>{person.name}</h3>}<p>{person.role}</p></figcaption></figure>)}</div>
      </div></div></section>
      <section class="workflow shell section-space" aria-labelledby="workflow-heading"><div class="section-heading"><p class="eyebrow">WSPÓŁPRACA</p><h2 id="workflow-heading">Jasny plan.<br /><span class="muted">Od pierwszej rozmowy.</span></h2></div><div class="workflow-grid"><article><h3>Rozmowa</h3><p>Poznajemy Twoją ofertę, odbiorców i cel. Ustalamy, czego potrzebujesz i jaki budżet chcesz przeznaczyć.</p></article><article><h3>Propozycja</h3><p>Dobieramy kanały i zakres działań. Przedstawiamy wycenę oraz plan, który wspólnie uzgadniamy.</p></article><article><h3>Realizacja</h3><p>Po akceptacji przechodzimy do działania. Pozostajemy w kontakcie i omawiamy kolejne kroki.</p></article></div></section>
      <Partners />
      <section id="kontakt" class="contact shell section-space" aria-labelledby="contact-heading">
        <div class="contact-top"><p class="eyebrow">KONTAKT</p><h2 id="contact-heading">Co chcesz<br /><span class="muted">powiedzieć światu?</span></h2></div>
        <div class="contact-details"><div><p>Opowiedz nam o swoim projekcie.<br />Ustalmy, od czego zacząć.</p><div class="contact-links"><a href="tel:+48576243368">+48 576 243 368</a><a href="mailto:biuro@bennyinvest.pl">biuro@bennyinvest.pl</a></div></div><div><h3>Benny Invest Sp. z o.o.</h3><p>NIP: 8513317048<br />REGON: 529454668<br />KRS: 0001123246</p></div><div><h3>Adres</h3><p>ul. 1 Maja<br />71-627 Szczecin, Polska</p></div></div>
      </section>
      <section class="coverage shell" aria-labelledby="coverage-heading"><div class="section-heading"><p class="eyebrow">OBSZAR DZIAŁANIA</p><div><h2 id="coverage-heading">Blisko Twoich<br /><span class="muted">odbiorców.</span></h2><p class="section-intro">Działamy w Szczecinie, Koszalinie, Stargardzie oraz pozostałych miejscowościach województwa zachodniopomorskiego.</p></div></div></section>
      <section class="location shell" aria-label="Mapa obszaru działania">
        <div class="map-frame"><div id="map-placeholder" class="map-placeholder"><p>Obszar działania</p><span>Mapa OpenStreetMap wczyta się po Twojej zgodzie.</span><button type="button" data-map-consent="allow">Wczytaj mapę</button></div><iframe id="location-map" hidden title="Mapa zachodniopomorskiego z czerwonym obrysem" data-src={sitePath('mapa/')} loading="lazy" referrerpolicy="no-referrer" allowfullscreen></iframe></div>
        <div class="map-bottom"><span>53°25′ N &nbsp; 14°33′ E</span><a href="https://www.openstreetmap.org/#map=7/53.5/15.4" target="_blank" rel="noopener noreferrer">Otwórz mapę <Arrow /></a></div>
      </section>
    </main>
    <QuoteForm />
    <CookieNotice />
    <noscript><p class="shell noscript-note">Aby poprosić o wycenę bez JavaScript, napisz na <a href="mailto:biuro@bennyinvest.pl">biuro@bennyinvest.pl</a>.</p></noscript>
    <footer class="shell flex flex-wrap items-center justify-between gap-5"><p>© {new Date().getFullYear()} Benny Invest Sp. z o.o.</p><button id="privacy-settings" type="button">Ustawienia prywatności</button><a href="#top">Do góry <span aria-hidden="true">↑</span></a></footer>
  </body>
</html>
