---
import '../styles/global.css';
import Arrow from '../components/Arrow.astro';
const services = [
  { n: '01', title: 'Kolportaż materiałów', category: 'DRUK / DYSTRYBUCJA', text: 'Ulotki, katalogi, materiały reklamowe. Pomagamy zaplanować dystrybucję tak, by komunikat trafił do odbiorców w wybranym obszarze.' },
  { n: '02', title: 'Reklama w taxi', category: 'MIASTO / W RUCHU', text: 'Twoja marka w codziennym rytmie miasta. Dobieramy formę obecności reklamowej w taksówkach do potrzeb kampanii.' },
  { n: '03', title: 'Kampanie Meta i Google Ads', category: 'DIGITAL / KAMPANIE', text: 'Reklama na Facebooku, Instagramie i w Google. Planowanie, uruchomienie i optymalizacja kampanii dopasowanych do Twojego celu i budżetu.' },
  { n: '04', title: 'Akcje promocyjne', category: 'MARKA / SPOTKANIE', text: 'Bezpośredni kontakt z odbiorcami. Organizujemy działania promocyjne, które pozwalają przedstawić markę, produkt lub ofertę w terenie.' }
];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Benny Invest, Szczecin. Kolportaż materiałów, reklama w taxi, kampanie Meta i Google Ads oraz akcje promocyjne. Porozmawiajmy o Twojej marce." />
    <meta name="theme-color" content="#f5f5f2" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Benny Invest — Reklama, która dociera.</title>
  </head>
  <body id="top">
    <a class="skip" href="#main">Przejdź do treści</a>
    <header class="shell flex items-center justify-between gap-6">
      <a href="#top" class="brand" aria-label="Benny Invest — strona główna">benny invest<span class="brand-period">.</span></a>
      <nav aria-label="Nawigacja główna" class="flex items-center gap-8 text-sm">
        <a class="desktop-link" href="#uslugi">Usługi</a><a class="desktop-link" href="#o-nas">O nas</a><a class="nav-contact" href="#kontakt">Kontakt <Arrow /></a>
      </nav>
    </header>
    <main id="main">
      <section class="hero shell" aria-labelledby="hero-heading">
        <div class="hero-meta"><p>REKLAMA / KOMUNIKACJA / PROMOCJA</p><p>SZCZECIN, PL</p></div>
        <div class="hero-grid">
          <div class="hero-copy"><h1 id="hero-heading">Reklama,<br />która<br /><span>dociera.</span></h1></div>
          <div class="hero-aside">
            <figure class="poster" aria-label="Autorska abstrakcyjna kompozycja czarnych i szarych linii, inspirowana sztuką geometryczną">
              <svg viewBox="0 0 480 460" role="img" aria-label="Rytm linii tworzących przestrzenną geometryczną kompozycję">
                <defs><pattern id="lines" width="11" height="11" patternUnits="userSpaceOnUse"><path d="M0 0v11" stroke="#191919" stroke-width="4" /></pattern></defs>
                <rect x="60" y="45" width="285" height="285" fill="url(#lines)" />
                <rect x="139" y="124" width="285" height="285" fill="#f5f5f2" />
                <rect x="139" y="124" width="285" height="285" fill="url(#lines)" transform="rotate(90 281.5 266.5)" />
                <rect x="139" y="124" width="206" height="206" fill="#a3a3a3" style="mix-blend-mode:multiply" />
                <path d="M60 365h45m-22.5-22.5v45" stroke="#191919" stroke-width="1" />
              </svg>
              <figcaption><span>FORMA / 001</span><span>BENNY INVEST</span></figcaption>
            </figure>
            <div class="hero-intro"><p>W mieście. W sieci. W bezpośrednim kontakcie.<br />Łączymy kanały reklamy z potrzebami Twojej marki.</p><a href="#uslugi" class="text-link">Poznaj nasze usługi <Arrow /></a></div>
          </div>
        </div>
        <div class="hero-bottom"><span>Dobry komunikat. Właściwe miejsce.</span><a href="#uslugi" aria-label="Przejdź do usług"><span aria-hidden="true">↓</span></a><span>01 — 04</span></div>
      </section>
      <section id="uslugi" class="services shell section-space" aria-labelledby="services-heading">
        <div class="section-heading"><p class="eyebrow">01 / CO ROBIMY</p><div><h2 id="services-heading">Cztery formy.<br /><span class="muted">Jeden komunikat.</span></h2><p class="section-intro">Dobieramy sposób dotarcia do tego, co chcesz powiedzieć.<br class="desktop-link" /> Od materiałów drukowanych po kampanie online.</p></div></div>
        <div class="service-list">{services.map(service => <article class="service-row"><span class="service-number">/{service.n}</span><div class="service-title"><p class="eyebrow">{service.category}</p><h3>{service.title}</h3></div><p class="service-description">{service.text}</p><a class="service-link" href={`mailto:biuro@bennyinvest.pl?subject=${encodeURIComponent(`Zapytanie: ${service.title}`)}`} aria-label={`Zapytaj o usługę: ${service.title}`}><Arrow /></a></article>)}</div>
      </section>
      <section id="o-nas" class="about" aria-labelledby="about-heading"><div class="shell about-grid section-space"><p class="eyebrow">02 / BENNY INVEST</p><div><h2 id="about-heading">Mniej szumu.<br />Więcej przekazu.</h2><div class="about-copy"><p>Jesteśmy ze Szczecina. Pomagamy markom docierać do odbiorców — na ulicy, w internecie i podczas akcji promocyjnych.</p><p>Zaczynamy od rozmowy o celu. Następnie dobieramy kanały, zakres i sposób działania. Jasno, konkretnie, z uwagą na Twoją markę.</p></div><a class="text-link" href="#kontakt">Porozmawiajmy o współpracy <Arrow /></a></div></div></section>
      <section id="kontakt" class="contact shell section-space" aria-labelledby="contact-heading">
        <div class="contact-top"><p class="eyebrow">03 / KONTAKT</p><h2 id="contact-heading">Co chcesz<br /><span class="muted">powiedzieć światu?</span></h2></div>
        <a class="email" href="mailto:biuro@bennyinvest.pl"><span>biuro@bennyinvest.pl</span><Arrow /></a>
        <div class="contact-details"><p>Opowiedz nam o swoim projekcie.<br />Ustalmy, od czego zacząć.</p><div><h3>Benny Invest Sp. z o.o.</h3><p>NIP: 8513317048</p></div><div><h3>Szczecin</h3><p>Polska</p></div></div>
      </section>
      <section class="location shell" aria-labelledby="location-heading">
        <div class="location-heading"><h2 id="location-heading">Tu zaczynamy. Szczecin.</h2><p>Mapa miasta · bez oznaczenia adresu siedziby</p></div>
        <div class="map-frame"><iframe title="Mapa Szczecina — OpenStreetMap" src="https://www.openstreetmap.org/export/embed.html?bbox=14.465%2C53.395%2C14.635%2C53.465&amp;layer=mapnik" loading="lazy" referrerpolicy="no-referrer" allowfullscreen></iframe></div>
        <div class="map-bottom"><span>53°25′ N &nbsp; 14°33′ E</span><a href="https://www.openstreetmap.org/#map=12/53.4285/14.5528" target="_blank" rel="noopener noreferrer">Otwórz mapę <Arrow /></a></div>
      </section>
    </main>
    <footer class="shell flex flex-wrap items-center justify-between gap-5"><p>© {new Date().getFullYear()} Benny Invest Sp. z o.o.</p><span class="footer-note">Prosto do odbiorcy.</span><a href="#top">Do góry <span aria-hidden="true">↑</span></a></footer>
  </body>
</html>
