  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "leaflet": "^1.9.4",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
