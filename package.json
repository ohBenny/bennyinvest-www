{
  "name": "bennyinvest-www",
  "version": "1.0.0",
  "description": "Statyczna strona Benny Invest w Astro i Tailwind CSS",
  "main": "index.js",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0",
